NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Supabase Postgres connection string (Project Settings → Database → Connection string → URI).
# Use the pooled (pgbouncer, port 6543) URL for the running API; the direct
# (port 5432) URL for drizzle-kit migrations, since migrations need a
# session-mode connection.
DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# All three secrets below: generate with `openssl rand -base64 32` (or
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Deliberately separate secrets (architecture.md §11, §16): a leaked magic-link
# or MFA-encryption key shouldn't also let someone forge API access tokens.
JWT_ACCESS_SECRET=
MAGIC_LINK_SECRET=
PASSWORD_RESET_SECRET=
MFA_ENCRYPTION_KEY=
ACCOUNTING_ENCRYPTION_KEY=
ACCOUNTING_OAUTH_STATE_SECRET=

# FR-PLAT-8: QuickBooks OAuth app credentials (Intuit developer account —
# free to create; no fee for API access in sandbox or production). Leave
# unset in dev — the connect flow only fails when actually invoked, same
# "optional, dialed lazily" precedent as ANTHROPIC_API_KEY.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox

# roadmap.md "Sage & Xero connectors" — same free-developer-app, optional/
# dialed-lazily precedent as QUICKBOOKS_* above.
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
WEBHOOK_ENCRYPTION_KEY=

# api.md §2.1: this API's externally-reachable origin, used to build SAML
# SP entity IDs / ACS URLs / metadata for enterprise SSO connections.
API_BASE_URL=http://localhost:3001

# File pipeline (architecture.md §13) — S3-compatible object store. Point
# S3_ENDPOINT at a local MinIO or R2 for dev; leave unset to use real AWS.
S3_BUCKET=constructionos-dev
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ClamAV clamd daemon (virus scan step). Defaults assume clamd running
# locally on its standard port.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
